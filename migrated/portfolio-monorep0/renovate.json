{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticPrefixFixDepsChoreOthers",
    ":timezone(Europe/Brussels)",
    ":dependencyDashboard",
    ":rebaseStalePrs",
    ":prHourlyLimitNone",
    ":prConcurrentLimit10"
  ],
  "platformAutomerge": true,
  "dependencyDashboard": true,
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "assignees": ["Tehen1"],
  "reviewers": ["Tehen1"],
  "ignorePaths": [
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/generated/**"
  ],
  "enabledManagers": [
    "npm",
    "dockerfile",
    "github-actions",
    "terraform",
    "regex"
  ],
  "packageRules": [
    {
      "description": "Group Next.js ecosystem",
      "groupName": "nextjs",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "automerge": false
    },
    {
      "description": "TRPC ecosystem",
      "groupName": "trpc",
      "matchPackagePatterns": ["^@trpc/"]
    },
    {
      "description": "Supabase ecosystem",
      "groupName": "supabase",
      "matchPackagePatterns": ["^@supabase/"]
    },
    {
      "description": "OpenTelemetry ecosystem",
      "groupName": "otel",
      "matchPackagePatterns": ["^@opentelemetry/"]
    },
    {
      "description": "Tailwind ecosystem",
      "groupName": "tailwind",
      "matchPackageNames": ["tailwindcss", "postcss", "autoprefixer"]
    },
    {
      "description": "Testing ecosystem",
      "groupName": "testing",
      "matchPackagePatterns": ["^vitest", "^jest", "^@testing-library/"]
    },
    {
      "description": "ESLint ecosystem",
      "groupName": "eslint",
      "matchPackagePatterns": ["^eslint", "^@typescript-eslint/"]
    },
    {
      "description": "TypeScript ecosystem",
      "groupName": "typescript",
      "matchPackageNames": ["typescript", "ts-node", "tsx"]
    },
    {
      "description": "Minor + patch automerge",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Never automerge major",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Critical infra deps",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@supabase/supabase-js",
        "prisma",
        "@prisma/client"
      ],
      "automerge": false
    },
    {
      "description": "Group AI stack",
      "groupName": "ai-stack",
      "matchPackagePatterns": [
        "^openai$",
        "^ai$",
        "^@ai-sdk/",
        "^langchain",
        "^ollama"
      ]
    },
    {
      "description": "Solidity ecosystem",
      "groupName": "solidity",
      "matchPackagePatterns": ["^@openzeppelin/", "^viem", "^wagmi"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "schedule": ["after 1am and before 5am every weekday"],
  "postUpdateOptions": ["pnpmDedupe"],
  "npm": {
    "enabled": true
  },
  "pnpm": {
    "enabled": true
  }
}
